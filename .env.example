# copy to .env and fill in whatever you have accounts for.
# platforms with missing vars get skipped by the runner, not failed.

COGNODB_URI=
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# neo4j aura free
NEO4J_AURA_URI=
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=

# memgraph cloud
MEMGRAPH_CLOUD_URI=
MEMGRAPH_CLOUD_USER=
MEMGRAPH_CLOUD_PASSWORD=

# arangograph trial
ARANGO_CLOUD_URL=
ARANGO_CLOUD_USER=root
ARANGO_CLOUD_PASSWORD=
ARANGO_CLOUD_DB=_system

# falkordb cloud
FALKORDB_CLOUD_HOST=
FALKORDB_CLOUD_PORT=6379
FALKORDB_CLOUD_PASSWORD=

# local docker stack, ports match docker-compose.yml
LOCAL_NEO4J_URI=bolt://localhost:7687
LOCAL_NEO4J_USER=neo4j
LOCAL_NEO4J_PASSWORD=benchpass123
LOCAL_MEMGRAPH_URI=bolt://localhost:7688
LOCAL_ARANGO_URL=http://localhost:8529
LOCAL_ARANGO_USER=root
LOCAL_ARANGO_PASSWORD=benchpass123
LOCAL_FALKORDB_HOST=localhost
LOCAL_FALKORDB_PORT=6380
